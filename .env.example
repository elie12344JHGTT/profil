# Valeurs pour Docker local uniquement. Ne pas les réutiliser en production.
# Copier ce fichier vers .env : les identifiants, la base et DATABASE_URL doivent rester alignés.

POSTGRES_USER=vodcast
POSTGRES_PASSWORD=vodcast
POSTGRES_DB=vodcast

# Hôte `db` : nom du service dans docker-compose. Prisma s'exécute dans le conteneur api.
DATABASE_URL=postgresql://vodcast:vodcast@db:5432/vodcast?schema=public

PORT=3000
NODE_ENV=development

# Clé de l'API YouTube Data v3 (console.cloud.google.com). Requis pour les métadonnées, pas pour /health.
YOUTUBE_API_KEY=remplacez-moi
