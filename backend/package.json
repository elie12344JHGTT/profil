{
  "name": "vodcast-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "nodemon",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 \"src/services/youtube/**/*.test.ts\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "prisma": "^7.10.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
